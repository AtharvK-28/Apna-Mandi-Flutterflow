# Copy to .env and fill in. .env is gitignored; this template is not.
#
# NOTE: every VITE_-prefixed variable is inlined into the client bundle at build
# time and is therefore PUBLIC. Never put a secret key here — anything that must
# stay secret belongs behind a backend this repo does not yet have. Of the keys
# below only the Supabase anon key, the Stripe *publishable* key and the
# analytics IDs are safe to expose; the model-provider keys are not, and are
# listed only because the scaffolding declared them.
#
# None of these are read anywhere in src/ today. Treat any integration as
# net-new work rather than "wiring up an existing client".

# Supabase — safe to expose (anon key is scoped by row-level security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Analytics — safe to expose
VITE_GOOGLE_ANALYTICS_ID=your-ga-measurement-id
VITE_ADSENSE_ID=your-adsense-id

# Payments — publishable key only, never the secret key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Model providers — NOT safe in a browser bundle. Proxy these through a backend
# rather than shipping them to the client.
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_PERPLEXITY_API_KEY=
